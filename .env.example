# MySQL 8+ / 9.x. O `db:migrate` cria o banco se ele nao existir.
# Prefira um usuario dedicado com acesso so a este banco, em vez de root:
#   CREATE USER 'crm_app'@'localhost' IDENTIFIED BY 'senha-alfanumerica';
#   GRANT ALL PRIVILEGES ON crm.* TO 'crm_app'@'localhost';
# Senha com @ : / ? # precisa de percent-encoding aqui.
DATABASE_URL="mysql://crm_app:senha@localhost:3306/crm"

# Segredo do cookie de sessao. Minimo de 32 caracteres.
# Gere com: node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
SESSION_SECRET="troque-este-valor"

# Senha do admin criado pelo seed. Se ausente, o seed usa "admin" e avisa no console.
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------
# E-mail das notificacoes (npm run worker).
# Sem SMTP_HOST o worker roda igual, registra a mensagem no console e marca
# como enviada - da para testar as regras sem servidor de e-mail nenhum.
# ---------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CRM Suporte + Dev <crm@suaempresa.com.br>"

# MySQL 8+ / 9.x. O banco precisa existir antes de rodar as migrations.
#   CREATE DATABASE crm CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
DATABASE_URL="mysql://root:senha@localhost:3306/crm"

# Segredo do cookie de sessao (etapa 2). Gere com: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-este-valor"

# Senha do admin criado pelo seed. Se ausente, o seed usa "admin" e avisa no console.
SEED_ADMIN_PASSWORD=""
